+/* The Nura driver implements the original EFI DT Fixup ABI. */
+struct uflinux_dt_fixup
+{
+  grub_efi_uint64_t revision;
+  grub_efi_status_t (__grub_efi_api *fixup) (struct uflinux_dt_fixup *, void *,
+                                            grub_efi_uintn_t *, grub_efi_uint32_t);
+};
+
+static grub_err_t
+uflinux_fixup_fdt (void)
+{
+  static grub_guid_t guid = { 0xe617d64c, 0xfe08, 0x46da,
+    { 0xf4, 0xdc, 0xbb, 0xd5, 0x87, 0x0c, 0x73, 0x00 } };
+  struct uflinux_dt_fixup *protocol;
+  grub_efi_uintn_t size, old_pages, pages;
+  grub_efi_status_t status;
+
+  if (!fdt || !loaded_fdt || !grub_env_get ("uflinux_dt_fixup"))
+    return GRUB_ERR_NONE;
+  protocol = grub_efi_locate_protocol (&guid, NULL);
+  if (!protocol)
+    return GRUB_ERR_NONE;
+
+  old_pages = GRUB_EFI_BYTES_TO_PAGES (grub_fdt_get_totalsize (fdt));
+  size = old_pages * 4096;
+  status = protocol->fixup (protocol, fdt, &size, 3);
+  if (status == GRUB_EFI_BUFFER_TOO_SMALL)
+    {
+      void *larger;
+      pages = GRUB_EFI_BYTES_TO_PAGES (size);
+      larger = grub_efi_allocate_pages_real (GRUB_EFI_MAX_USABLE_ADDRESS, pages,
+                                             GRUB_EFI_ALLOCATE_MAX_ADDRESS,
+                                             GRUB_EFI_ACPI_RECLAIM_MEMORY);
+      if (!larger)
+        return grub_error (GRUB_ERR_OUT_OF_MEMORY, "cannot expand device tree");
+      grub_memcpy (larger, fdt, grub_fdt_get_totalsize (fdt));
+      grub_efi_free_pages ((grub_addr_t) fdt, old_pages);
+      fdt = larger;
+      size = pages * 4096;
+      status = protocol->fixup (protocol, fdt, &size, 3);
+    }
+  if (status != GRUB_EFI_SUCCESS)
+    return grub_error (GRUB_ERR_BAD_OS, "EFI device tree fixup failed: %lx",
+                       (unsigned long) status);
+  return GRUB_ERR_NONE;
+}
+
 grub_err_t
 grub_fdt_install (void)
 {
@@ -101,6 +148,9 @@
 
   if (fdt == NULL && loaded_fdt == NULL)
     return GRUB_ERR_NONE;
+
+  if (uflinux_fixup_fdt () != GRUB_ERR_NONE)
+    return grub_errno;
 
