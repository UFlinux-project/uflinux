{
  "qcs6490": {
    "label": "Arrow Dragon Q6A and similar QCS6490 boards",
    "arches": ["aarch64"],
    "kernel": "dragon-q6a",
    "initramfs_compression": "gzip",
    "boot": "efi",
    "rootfs": "f2fs",
    "status": "experimental",
    "serial": "ttyMSM0",
    "cmdline": "loglevel=7",
    "img_size_mib": 6144,
    "nura": true,
    "dtb": "qcom/qcs6490-radxa-dragon-q6a.dtb",
    "initramfs_files": [
      "lib/firmware/qcom/qcm6490/qupv3fw.elf.zst",
      "lib/firmware/qcom/a660_sqe.fw.zst",
      "lib/firmware/qcom/a660_gmu.bin.zst",
      "lib/firmware/qcom/qcs6490/a660_zap.mbn.zst"
    ],
    "initramfs_modules": ["simple-bridge", "display-connector"],
    "packages": ["linux-firmware-qcom", "mesa-vulkan-freedreno", "alsa-ucm-conf", "grub-efi", "efibootmgr"],
    "nura_packages": ["dtbloader"]
  },
  "rpi": {
    "label": "Raspberry Pi 3, 4 and 5",
    "arches": ["aarch64"],
    "kernel": "rpi",
    "boot": "rpi",
    "rootfs": "f2fs",
    "status": "supported",
    "serial": "ttyAMA0",
    "cmdline": "quiet",
    "img_size_mib": 6144,
    "nura": false,
    "nura_packages": [],
    "packages": ["raspberrypi-bootloader", "raspberrypi-bootloader-common", "mesa-vulkan-broadcom", "mesa-vulkan-panfrost", "alsa-ucm-conf"]
  },
  "spacemit-k1": {
    "label": "SpacemiT K1 boards (Orange Pi RV2, Orange Pi R2S, BananaPi-F3)",
    "arches": ["riscv64"],
    "kernel": "orangepi-rv2",
    "boot": "extlinux",
    "rootfs": "f2fs",
    "status": "experimental",
    "serial": "ttyS0",
    "cmdline": "quiet console=ttyS0,115200n8",
    "img_size_mib": 6144,
    "nura": false,
    "nura_packages": [],
    "dtb": "ky/x1_orangepi-rv2.dtb",
    "packages": ["mesa-vulkan-swrast", "xf86-video-fbdev"]
  },
  "pc-xfs": {
    "label": "PCs with hard drives or SSDs (BIOS and UEFI)",
    "arches": ["x86_64"],
    "kernel": "x86_64",
    "boot": "pc",
    "rootfs": "xfs",
    "status": "supported",
    "serial": "ttyS0",
    "cmdline": "quiet console=tty0 console=ttyS0,115200n8",
    "img_size_mib": 4096,
    "nura": false,
    "nura_packages": [],
    "packages": ["grub-efi", "grub-bios", "amd-ucode", "intel-ucode", "mesa-vulkan-intel", "mesa-vulkan-nouveau", "mesa-vulkan-virtio"]
  },
  "pc-f2fs": {
    "label": "PCs with flash drives or SD cards (BIOS and UEFI)",
    "arches": ["x86_64"],
    "kernel": "x86_64",
    "boot": "pc",
    "rootfs": "f2fs",
    "f2fs_compress": "lz4",
    "status": "supported",
    "serial": "ttyS0",
    "cmdline": "quiet console=tty0 console=ttyS0,115200n8",
    "img_size_mib": 4096,
    "nura": false,
    "nura_packages": [],
    "packages": ["grub-efi", "grub-bios", "amd-ucode", "intel-ucode", "mesa-vulkan-intel", "mesa-vulkan-nouveau", "mesa-vulkan-virtio"]
  },
  "vm": {
    "label": "Virtual machines (QEMU, KVM, hypervisors)",
    "arches": ["x86_64", "aarch64"],
    "kernel": "virt-{arch}",
    "boot": "efi",
    "rootfs": "xfs",
    "status": "supported",
    "serial": "ttyS0",
    "cmdline": "quiet console=ttyS0,115200n8",
    "img_size_mib": 5120,
    "nura": false,
    "nura_packages": [],
    "packages": ["qemu-guest-agent", "qemu-guest-agent-openrc", "grub-efi", "efibootmgr", "mesa-vulkan-virtio"]
  }
}
