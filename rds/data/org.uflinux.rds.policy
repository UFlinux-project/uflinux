<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>UFLinux</vendor>
  <icon_name>org.uflinux.Settings</icon_name>
  <action id="org.uflinux.rds.configure">
    <description>Manage Remote Desktop settings and sessions</description>
    <message>Administrator authentication is required to manage Remote Desktop</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
  <action id="org.uflinux.rds.certificate">
    <description>Install the Remote Desktop TLS certificate</description>
    <message>Authentication is required to change the Remote Desktop certificate</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
</policyconfig>
