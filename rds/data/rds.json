{
  "enabled": false,
  "rdp_port": 3389,
  "rdp_bind": "0.0.0.0",
  "nla_required": false,
  "allowed_users": [],
  "allowed_groups": [],
  "max_sessions": 4,
  "idle_timeout_secs": 900,
  "linger_secs": 0,
  "session_command": "uflinux-session",
  "codec": {
    "h264": "auto",
    "allow_remotefx": true,
    "rfx_quant": 20,
    "max_fps": 30,
    "vaapi_device": null
  },
  "web": {
    "enabled": true,
    "port": 3390,
    "bind": "0.0.0.0",
    "https": true,
    "certificate": {
      "source": "self_signed"
    },
    "token_ttl_minutes": 5
  }
}
