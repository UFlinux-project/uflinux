# Configuration for /etc/init.d/uflinux-rds
#
# Every variable below is optional; the broker falls back to its built-in
# defaults. Un-comment and edit, then `rc-service uflinux-rds restart`. The
# init script forwards these to the daemon, so no `export` keyword is needed.
# Anything set here wins over /etc/uflinux/rds.json, which is what the Remote
# Desktop page in uflinux-settings writes.

# Path of the control socket the broker listens on (default below). The service
# pidfile is created next to it, so changing this moves the pidfile too.
#UFLINUX_RDS_CONTROL_SOCKET=/run/uflinux-rds/control.sock

# H.264 video codec: auto | force | off
#UFLINUX_RDS_H264=auto

# TCP port for the native RDP listener (default: 3389)
#UFLINUX_RDS_RDP_PORT=3389

# TCP port for the embedded web gateway (default: 3390)
#UFLINUX_RDS_WEB_PORT=3390

# Command that starts the user session inside the broker (default:
# uflinux-session, the distro launcher; a bare compositor such as labwc starts
# without a session bus, so the desktop shell cannot attach)
#UFLINUX_RDS_SESSION_COMMAND=uflinux-session
