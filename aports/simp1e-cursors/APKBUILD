# Maintainer: Dominik Hejl <admin@xdkil.cz>
#
# Trimmed copy of Alpine's testing/simp1e-cursors recipe. Upstream builds one
# subpackage per colour scheme, which would mean 49 packages for the ISO, and
# the package only exists in Alpine's testing repository while uflinux uses the
# pinned release's main and community repositories. Only the two schemes uflinux
# ships are generated here: the base theme and the Adwaita dark variant that is
# the desktop default.
pkgname=simp1e-cursors
pkgver=0_git20250312
pkgrel=1
pkgdesc="An aesthetic cursor theme for your Linux desktop"
url="https://gitlab.com/cursors/simp1e"
arch="noarch"
license="GPL-3.0-only"
makedepends="bash python3 py3-pillow rsvg-convert xcursorgen"
options="!check" # no tests
_gitrev=f8f8f3c09dd0aa31cc9bc5499c683aad025984be
_buildscript=dd4a730c4a45c73c580220658bd1f21f141f8a55
source="$pkgname-$_gitrev.tar.gz::https://gitlab.com/cursors/simp1e/-/archive/$_gitrev/simp1e-$_gitrev.tar.gz
	cursor-generator-$_buildscript.tar.gz::https://gitlab.com/cursors/cursor-generator/-/archive/$_buildscript/cursor-generator-$_buildscript.tar.gz
	"
builddir="$srcdir"/simp1e-$_gitrev
# The Adwaita dark variant is the desktop default, so it is split out: a system
# can drop the uflinux default while keeping the base theme. The variant still
# depends on the base scheme, which is what puts simp1e-cursors in an image that
# selects it.
subpackages="$pkgname-adw-dark:adw_dark"

prepare() {
	default_prepare
	mv "$srcdir"/cursor-generator-$_buildscript/* "$builddir"/cursor-generator
}

build() {
	# The generator's inclusion list filters both the colour schemes and the
	# templates, so cursors.svg is listed to keep the left-handed variant out.
	./build.sh --include=Simp1e.txt,Simp1e-Adw-Dark.txt,cursors.svg
}

package() {
	mkdir -p "$pkgdir"/usr/share/icons
	mv built_themes/* "$pkgdir"/usr/share/icons/
	mv "$pkgdir"/usr/share/icons/Simp1e "$pkgdir"/usr/share/icons/"$pkgname"

	install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

adw_dark() {
	pkgdesc="$pkgdesc (Adw Dark scheme)"
	# abuild only gives a subpackage an automatic dependency on its main package
	# for the suffixes it knows about, so a custom one has to ask for it. Without
	# this the variant would install on its own and the base scheme would never
	# reach an image.
	depends="$pkgname=$pkgver-r$pkgrel"
	mkdir -p "$subpkgdir"/usr/share/icons
	# The generator sanitizes the scheme name, so "Simp1e Adw Dark" is built as
	# the hyphenated directory.
	mv "$pkgdir"/usr/share/icons/Simp1e-Adw-Dark "$subpkgdir"/usr/share/icons/"$subpkgname"
}

