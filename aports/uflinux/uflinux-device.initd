#!/sbin/openrc-run
# shellcheck shell=sh disable=SC2034

name="uflinux-device"
description="Grow the UFLinux device image root filesystem to the size of the storage medium"

device_marker="/etc/uflinux/device"
state_dir="/var/lib/uflinux"
state_file="$state_dir/device-resized"

depend() {
	# Root is already mounted by the initramfs; waiting for localmount while
	# ordering before modules creates a cycle through fsck/root/localmount.
	# Run after checks and before the regular root remount.
	need fsck
	after modules clock
	before root localmount bootmisc
}

# Split a root block device such as /dev/mmcblk0p2 or /dev/sda2 into the disk
# and the partition index. Sets grow_disk, grow_part and grow_sep.
split_root_device() {
	local tail last digits
	grow_disk=""
	grow_part=""
	grow_sep=""
	tail="$1"
	digits=""
	while [ -n "$tail" ]; do
		last="${tail#"${tail%?}"}"
		tail="${tail%?}"
		case $last in
			[0-9]) digits="$last$digits" ;;
			p)
				[ -n "$digits" ] || return 1
				grow_disk="$tail"
				grow_part="$digits"
				grow_sep="p"
				return 0
				;;
			*)
				[ -n "$digits" ] || return 1
				grow_disk="$tail$last"
				grow_part="$digits"
				grow_sep=""
				return 0
				;;
		esac
	done
	return 1
}

start() {
	[ -e "$device_marker" ] || return 0
	[ -e "$state_file" ] && return 0

	ebegin "Preparing UFLinux device storage"
	# F2FS growth is an offline operation. Even a read-only mount keeps cached
	# metadata which becomes stale if resize.f2fs changes the backing device,
	# so the initramfs grew the partition and the filesystem before it mounted
	# the root. Record that here so the check is not repeated on every boot,
	# and touch neither the partition table nor the mount.
	source="$(findmnt -no SOURCE /)" || source=""
	fstype="$(findmnt -no FSTYPE /)" || fstype=""
	if [ "$fstype" = f2fs ]; then
		einfo "F2FS root was expanded offline during boot"
		mkdir -p "$state_dir"
		if [ -n "$source" ] && split_root_device "$source"; then
			printf 'disk=%s\npartition=%s\nfilesystem=f2fs\n' \
				"$grow_disk" "$grow_part" >"$state_file"
		else
			printf 'disk=unknown\npartition=unknown\nfilesystem=f2fs\n' >"$state_file"
		fi
		eend 0
		return 0
	fi
	if [ -z "$source" ] || ! split_root_device "$source"; then
		ewarn "cannot determine the root disk of $source, skipping the resize"
		eend 0
		return 0
	fi

	disk="$grow_disk"
	part="$grow_part"
	root_part="$disk$grow_sep$part"
	if [ ! -b "$disk" ] || [ ! -b "$root_part" ]; then
		ewarn "$disk or $root_part is not a block device, skipping the resize"
		eend 0
		return 0
	fi

	# Only grow a GPT disk that still has unallocated space at the end.
	if growpart --dry-run "$disk" "$part" >/dev/null 2>&1; then
		if ! growpart "$disk" "$part"; then
			ewarn "growpart failed for $disk$grow_sep$part"
			eend 1
			return 1
		fi
	fi

	# Only filesystems with supported online growth reach this point.
	# ext4 and XFS want a writable mount, so they get the remount first.
	case "$fstype" in
	xfs)
		mount -o remount,rw / 2>/dev/null
		if ! xfs_growfs /; then
			ewarn "xfs_growfs failed for $root_part"
			eend 1
			return 1
		fi
		;;
	ext4 | ext3 | ext2)
		mount -o remount,rw / 2>/dev/null
		if ! resize2fs "$root_part"; then
			ewarn "resize2fs failed for $root_part"
			eend 1
			return 1
		fi
		;;
	*)
		ewarn "$root_part is $fstype, which cannot be grown here"
		;;
	esac

	mkdir -p "$state_dir"
	printf 'disk=%s\npartition=%s\nfilesystem=%s\n' "$disk" "$part" "$fstype" >"$state_file"
	eend 0
}
