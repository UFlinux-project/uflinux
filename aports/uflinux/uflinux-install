#!/usr/bin/python3
"""Install to explicitly mounted, preformatted partitions; never run a mkfs."""
import argparse
import contextlib
import fcntl
import getpass
import json
import os
from pathlib import Path
import re
import shutil
import stat
import subprocess
import sys
import tarfile
import tempfile


class InstallError(RuntimeError):
    pass


def run(*args, **kwargs):
    return subprocess.run(args, check=True, text=True, **kwargs)


def output(*args, **kwargs):
    return run(*args, stdout=subprocess.PIPE, **kwargs).stdout.strip()


def describe_apk_log(target):
    """Report what apk recorded, since setup-disk only says that it failed.

    A package that apk considers broken, for instance one whose owner it could
    not restore on the vfat ESP, aborts the installation without naming itself.
    """
    try:
        lines = (target / "var/log/apk.log").read_text(errors="replace").splitlines()
    except OSError:
        print("uflinux-install: the target holds no var/log/apk.log", file=sys.stderr)
        return
    recorded = [line for line in lines if "ERROR" in line or "WARNING" in line]
    if not recorded:
        print("uflinux-install: var/log/apk.log holds no errors or warnings", file=sys.stderr)
        return
    print("uflinux-install: last apk log records:", file=sys.stderr)
    for line in recorded[-20:]:
        print("  " + line, file=sys.stderr)


def configure_early_graphics(target, kernel, drm=Path('/sys/class/drm')):
    """Include the active graphics drivers, not every GPU and its firmware."""
    modules = set()
    for card in drm.glob('card*'):
        if not re.fullmatch(r'card[0-9]+', card.name):
            continue
        module = card / 'device/driver/module'
        if module.exists():
            modules.add(module.resolve().name.replace('-', '_'))
    gpu = target / 'lib/modules' / kernel / 'kernel/drivers/gpu'
    paths = set()
    if gpu.exists():
        for module in gpu.rglob('*.ko*'):
            name = module.name.split('.ko', 1)[0].replace('-', '_')
            if name in modules and module.is_file():
                paths.add(str(module.relative_to(target / 'lib/modules' / kernel)).split('.ko', 1)[0] + '.ko*')
    feature = target / 'etc/mkinitfs/features.d/uflinux-graphics.modules'
    feature.parent.mkdir(parents=True, exist_ok=True)
    feature.write_text(''.join(path + '\n' for path in sorted(paths)))


def mounted(path, filesystem):
    try:
        result = json.loads(output("findmnt", "--json", "--mountpoint", str(path),
                                   "--output", "TARGET,SOURCE,FSTYPE,OPTIONS,UUID"))
    except (subprocess.CalledProcessError, json.JSONDecodeError) as exc:
        raise InstallError(f"{path} must be an explicit mount point") from exc
    mounts = result.get("filesystems", [])
    if len(mounts) != 1:
        raise InstallError(f"Expected exactly one mount at {path}")
    mount = mounts[0]
    if mount["target"] != str(path) or mount["fstype"] != filesystem:
        raise InstallError(f"{path} must be mounted as {filesystem}")
    if "rw" not in mount["options"].split(",") or not mount.get("uuid"):
        raise InstallError(f"{path} must be writable and have a filesystem UUID")
    source = Path(mount["source"])
    if not source.exists() or not stat.S_ISBLK(source.stat().st_mode):
        raise InstallError(f"{path} must be backed by a block device")
    return mount


def walk_devices(devices):
    for device in devices:
        yield device
        yield from walk_devices(device.get("children", []))


BIOS_BOOT_GUID = "21686148-6449-6e6f-744e-656564454649"


def validate_bios_disk(table):
    parts = table.get("partitions", [])
    sector_bytes = int(table.get("sectorsize", 512))
    if table.get("label") == "gpt":
        candidates = [part for part in parts if part.get("type", "").lower() == BIOS_BOOT_GUID]
        if len(candidates) == 1 and candidates[0]["size"] * sector_bytes >= 1024 * 1024:
            return
        raise InstallError("BIOS on GPT requires one dedicated BIOS boot partition of at least 1 MiB")
    if table.get("label") == "dos" and parts and min(part["start"] for part in parts) * sector_bytes >= 1024 * 1024:
        return
    raise InstallError("BIOS on MBR requires at least 1 MiB before the first partition")


def efi_partition(source):
    """Identify a direct EFI system partition for firmware registration."""
    try:
        info = json.loads(output("lsblk", "--json", "--nodeps", "--paths", "--output",
                                 "PATH,TYPE,PARTN,PKNAME,PARTTYPE", source))["blockdevices"]
        if len(info) != 1:
            raise ValueError("expected one device")
        part = info[0]
        partition = int(part["partn"])
        parent = part["pkname"]
        parttype = (part.get("parttype") or "").lower()
        if part["type"] != "part" or partition < 1 or not parent:
            raise ValueError("not a direct partition")
        if parttype not in {"c12a7328-f81f-11d2-ba4b-00a0c93ec93b", "0xef", "ef"}:
            raise ValueError("incorrect partition type")
        return {"disk": parent, "partition": partition}
    except (subprocess.CalledProcessError, json.JSONDecodeError, KeyError, TypeError, ValueError) as exc:
        raise InstallError("/boot must be a directly attached EFI system partition with the EFI partition type") from exc


def preflight(args):
    if os.geteuid() != 0:
        raise InstallError("Run this installer with doas from the live session")
    if not re.fullmatch(r"[a-z_][a-z0-9_-]{0,30}", args.user) or args.user in {"root", "live", "greetd"}:
        raise InstallError("Choose a normal user name other than root, live, or greetd")
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,62}", args.hostname):
        raise InstallError("Invalid hostname")
    target = Path(args.target).resolve()
    if str(target) in {"/", "/boot", "/home", "/etc", "/usr", "/var"}:
        raise InstallError("Refusing to use a live system directory as the installation root")
    root = mounted(target, "xfs")
    mode = args.boot_mode
    if mode == "auto":
        mode = "uefi" if Path("/sys/firmware/efi").exists() else "native"
    arch = output("apk", "--print-arch")
    if mode == "native" and arch == "x86_64":
        mode = "bios"
    boot = mounted(target / "boot", "vfat" if mode in {"uefi", "bios"} else "ext4")
    if root["source"] == boot["source"]:
        raise InstallError("/boot must be a separate filesystem")
    unexpected = {p.name for p in target.iterdir()} - {"boot", "lost+found"}
    if unexpected:
        raise InstallError("Target root must be empty apart from boot and lost+found")
    if arch not in SUPPORTED_ARCHES:
        raise InstallError(f"Unsupported architecture: {arch}")
    if mode == "bios" and arch != "x86_64":
        raise InstallError("BIOS mode is only available for x86_64")
    esp = None
    efi_target = None
    if mode == "uefi":
        if arch == "ppc64le":
            raise InstallError(f"UEFI is not supported for {arch}")
        esp = boot
        if output("blkid", "--probe", "-s", "VERSION", "-o", "value", esp["source"]) != "FAT32":
            raise InstallError("The EFI system partition must be FAT32")
        efi_target = efi_partition(esp["source"])
        loader = "grub"
    elif arch in {"x86_64", "ppc64le"}:
        loader = "grub"
        if not args.boot_disk:
            raise InstallError("--boot-disk is required for BIOS and PowerPC installations")
    else:
        raise InstallError(f"Boot the {arch} ISO through UEFI; board-specific U-Boot installation is outside this installer")
    if args.boot_disk:
        disk = Path(args.boot_disk).resolve()
        if not disk.exists() or not stat.S_ISBLK(disk.stat().st_mode):
            raise InstallError("--boot-disk must identify a whole block device")
        devices = json.loads(output("lsblk", "--json", "--tree", "--output",
                                   "PATH,TYPE,PTTYPE,PARTTYPE,MOUNTPOINTS", str(disk)))["blockdevices"]
        if len(devices) != 1 or devices[0]["type"] != "disk":
            raise InstallError("--boot-disk must identify a whole disk, not a partition")
        entries = list(walk_devices(devices))
        if any(str(m).startswith(("/media/", "/run/media/"))
               for entry in entries for m in (entry.get("mountpoints") or []) if m):
            raise InstallError("Refusing to write a bootloader to a disk containing mounted live media")
        ancestors = output("lsblk", "--inverse", "--noheadings", "--paths", "--list", "--output", "NAME", boot["source"]).splitlines()
        if str(disk) not in [line.strip() for line in ancestors]:
            raise InstallError("The boot filesystem is not on --boot-disk")
        types = {str(entry.get("parttype", "")).lower() for entry in entries}
        if arch == "ppc64le" and not types.intersection({"0x41", "41", "9e1a2d38-c612-4316-aa26-8b49521e5a8b"}):
            raise InstallError("PowerPC requires an existing PReP boot partition")
        if mode == "bios":
            try:
                table = json.loads(output("sfdisk", "--json", str(disk)))["partitiontable"]
            except (subprocess.CalledProcessError, json.JSONDecodeError, KeyError) as exc:
                raise InstallError("Cannot inspect the BIOS boot disk partition table") from exc
            validate_bios_disk(table)
            if output("blkid", "--probe", "-s", "VERSION", "-o", "value", boot["source"]) != "FAT32":
                raise InstallError("BIOS /boot must be FAT32")
    return {"target": str(target), "root": root, "boot": boot, "esp": esp,
            "arch": arch, "mode": mode, "loader": loader, "boot_disk": args.boot_disk, "efi_target": efi_target}


def write(root, name, value, mode=0o644):
    path = root / name
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(value)
    path.chmod(mode)


def browser_world(arch):
    """The browser lines of etc/apk/world, which must name a package the
    architecture's repositories actually carry: Alpine has no riscv64 firefox,
    only firefox-esr, and ublock-origin installs into /usr/lib/firefox."""
    if arch == "riscv64":
        return "firefox-esr\n"
    return "firefox\nublock-origin\n"


def firmware_world():
    """The firmware lines of etc/apk/world, carried over from the live system.

    The live image names Alpine's firmware subpackages instead of the
    linux-firmware metapackage, which pins the Snapdragon-only
    linux-firmware-qcom, so the installed system mirrors whatever the running
    image selected. Falling back to the metapackage keeps firmware present even
    when the installer runs outside a live image.
    """
    try:
        world = Path("/etc/apk/world").read_text()
    except OSError:
        return "linux-firmware\n"
    kept = sorted({line for line in world.split() if line.startswith("linux-firmware")})
    return "".join(line + "\n" for line in kept) or "linux-firmware\n"


def make_overlay(directory, args, repositories=None, uefi=False):
    write(directory, "etc/hostname", args.hostname + "\n")
    world = "alpine-base\nmusl\nmusl-utils\nuflinux\nxfsprogs\n" + firmware_world()
    world += browser_world(args.arch)
    if uefi:
        world += "grub-efi\n"
    elif args.arch == "x86_64":
        world += "grub-bios\n"
    elif args.arch == "ppc64le":
        world += "grub-ieee1275\n"
    if args.arch == "x86_64":
        world += "amd-ucode\nintel-ucode\n"
    if getattr(args, "gui_locale", False):
        world += "musl-locales\nmusl-locales-lang\nglib-lang\ngtk4.0-lang\nlabwc-lang\n"
    write(directory, "etc/apk/world", world)
    write(directory, "etc/shadow", "root:!:19000:0:99999:7:::\n", 0o600)
    write(directory, "etc/network/interfaces", "auto lo\niface lo inet loopback\n")
    serial = {"aarch64": "ttyAMA0", "ppc64le": "hvc0"}.get(args.arch, "ttyS0")
    write(directory, "etc/inittab", "::sysinit:/sbin/openrc sysinit\n::sysinit:/sbin/openrc boot\n"
          "::wait:/sbin/openrc default\ntty2::respawn:/sbin/getty 38400 tty2\n"
          f"{serial}::respawn:/sbin/getty -L 115200 {serial} vt100\n"
          "::ctrlaltdel:/sbin/reboot\n::shutdown:/sbin/openrc shutdown\n")
    write(directory, "etc/apk/repositories", repositories if repositories is not None else Path("/usr/share/uflinux/repositories").read_text())
    keys = directory / "etc/apk/keys"
    keys.mkdir(parents=True)
    for key in Path("/etc/apk/keys").glob("*.pub"):
        shutil.copy2(key, keys / key.name)
    for service, level in [("devfs", "sysinit"), ("dmesg", "sysinit"),
                           ("udev", "sysinit"), ("udev-trigger", "sysinit"), ("udev-settle", "sysinit"),
                           ("hwdrivers", "sysinit"), ("uflinux-splash", "sysinit"),
                           ("uflinux-splash-stop", "default"), ("hwclock", "boot"), ("modules", "boot"),
                           ("sysctl", "boot"), ("hostname", "boot"), ("bootmisc", "boot"),
                           ("uflinux-zram", "boot"),
                           ("syslog", "boot"), ("dbus", "default"), ("elogind", "default"),
                           ("iwd", "default"), ("connman", "default"), ("connman-vpn", "default"), ("bluetooth", "default"),
                           ("tlp", "default"), ("uflinux-acpid", "default"),
                           ("uflinux-routes", "default"), ("greetd", "default"),
                           ("killprocs", "shutdown"), ("mount-ro", "shutdown")]:
        path = directory / "etc/runlevels" / level / service
        path.parent.mkdir(parents=True, exist_ok=True)
        path.symlink_to("/etc/init.d/" + service)
        if level == "default" and service != "greetd":
            tty = directory / "etc/runlevels/tty" / service
            tty.parent.mkdir(parents=True, exist_ok=True)
            tty.symlink_to("/etc/init.d/" + service)


@contextlib.contextmanager
def temporary_repositories(path, text):
    original = path.read_bytes()
    try:
        path.write_text(text)
        yield
    finally:
        path.write_bytes(original)


EFI_ARCH = {"x86_64": "x64", "aarch64": "aa64", "riscv64": "riscv64"}
SUPPORTED_ARCHES = {*EFI_ARCH, "ppc64le"}


def kernel_flavor(arch):
    return {"x86_64": "uflinux-x86_64", "aarch64": "uflinux-aarch64"}.get(arch, "lts")


def install_arm64_efi_hook(target, flavor):
    hook = target / "etc/apk/commit_hooks.d/uflinux-efi-kernel"
    hook.parent.mkdir(parents=True, exist_ok=True)
    hook.write_text("""#!/bin/sh
set -eu
[ "$1" = post-commit ] || exit 0
source=/boot/vmlinuz-FLAVOR
[ -s "$source" ] || exit 1
temporary=$(mktemp /boot/.uflinux-kernel.XXXXXX)
trap 'unlink "$temporary" 2>/dev/null || :' EXIT
if [ "$(head -c 2 "$source")" = MZ ]; then
    cp "$source" "$temporary"
else
    gzip -dc "$source" > "$temporary"
fi
[ "$(head -c 2 "$temporary")" = MZ ]
mv "$temporary" /boot/vmlinuz-FLAVOR.efi
""".replace("FLAVOR", flavor))
    hook.chmod(0o755)
    run("chroot", str(target), "/etc/apk/commit_hooks.d/uflinux-efi-kernel", "post-commit")


def boot_mitigations(target):
    """The mitigations token for the generated entries.

    The installed system's own policy wins, so reinstalling keeps the choice
    made in Settings. A target without a policy file inherits the choice of
    the running system, which is the live session during an installation.
    """
    for path in (target / "etc/uflinux/boot.conf", Path("/etc/uflinux/boot.conf")):
        try:
            lines = path.read_text().splitlines()
        except OSError:
            continue
        for line in lines:
            key, _, value = line.partition("=")
            if key.strip() == "mitigations":
                return "auto" if value.strip() == "auto" else "off"
    return "off"


def install_grub(target, plan, media):
    arch, mode = plan["arch"], plan["mode"]
    boot = target / "boot"
    grub = boot / "grub"
    shutil.copytree(target / "usr/share/uflinux/grub-theme", grub / "themes/uflinux", dirs_exist_ok=True)
    for repository in map(Path, media):
        memtest = repository.parent / "boot/grub/memtest86plus"
        if memtest.is_file():
            shutil.copy2(memtest, grub)
            break
    flavor = kernel_flavor(arch)
    extension = ".efi" if arch == "aarch64" else ""
    initrds = ["/" + name for name in ("amd-ucode.img", "intel-ucode.img") if (boot / name).is_file()]
    initrds.append(f"/initramfs-{flavor}")
    serial = {"aarch64": "ttyAMA0", "ppc64le": "hvc0"}.get(arch, "ttyS0")
    config = output("chroot", str(target), "/usr/libexec/uflinux-boot-menu",
                    f"/vmlinuz-{flavor}{extension}", " ".join(initrds), "",
                    f"root=UUID={plan['root']['uuid']} rootfstype=xfs rw console=tty0 console={serial},115200", "/grub",
                    env=dict(os.environ, UFLINUX_MITIGATIONS=boot_mitigations(target)))
    write(boot, "grub/grub.cfg", config + "\n")
    write(target, "etc/update-grub.conf", "disable_trigger=1\n")
    if mode == "bios":
        run("grub-install", "--target=i386-pc", "--boot-directory=" + str(boot), plan["boot_disk"])
        return
    if mode != "uefi":
        return  # Alpine setup-disk installs GRUB to the PowerPC PReP partition.
    platform = {"x86_64": "x86_64-efi", "aarch64": "arm64-efi", "riscv64": "riscv64-efi"}[arch]
    run("grub-install", "--target=" + platform, "--no-nvram", "--bootloader-id=UFLinux",
        "--efi-directory=" + str(boot), "--boot-directory=" + str(boot))
    suffix = EFI_ARCH[arch]
    binary = boot / "EFI/UFLinux" / f"grub{suffix}.efi"
    fallback = boot / "EFI/BOOT" / f"BOOT{suffix.upper()}.EFI"
    if not fallback.exists():
        fallback.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(binary, fallback)
    target_disk = plan["efi_target"]
    variables = Path("/sys/firmware/efi/efivars")
    if not variables.is_dir():
        raise InstallError("UEFI variables are unavailable; boot the installer in UEFI mode")
    if not variables.is_mount():
        run("mount", "-t", "efivarfs", "efivarfs", str(variables))
    run("efibootmgr", "--create", "--disk", target_disk["disk"],
        "--part", str(target_disk["partition"]), "--label", "UFLinux",
        "--loader", "\\EFI\\UFLinux\\" + binary.name)


def install(args, plan, password):
    target = Path(plan["target"])
    args.arch = plan["arch"]
    flavor = kernel_flavor(args.arch)
    full_repositories = Path("/usr/share/uflinux/repositories").read_text()
    source_repositories = Path("/etc/apk/repositories")
    media = [line.strip() for line in source_repositories.read_text().splitlines()
             if line.startswith("/") and (Path(line.strip()) / ".boot_repository").is_file()]
    if media:
        # A first release is tested before its public custom repository exists.
        # Its custom packages come from the signed ISO instead.
        kernel_indexes = [str(path) for directory in media
                          if (path := Path(directory) / "kernels" / args.arch / "Packages.adb").is_file()]
        if flavor != "lts" and not kernel_indexes:
            raise InstallError("Installation media is missing its kernel repository")
        online = [line for line in full_repositories.splitlines()[1:] if not line.endswith("/Packages.adb")]
        repositories = media + kernel_indexes + (online if args.online else [])
        install_repositories = "\n".join(repositories) + "\n"
    else:
        install_repositories = full_repositories
    # setup-disk receives a clean overlay, never a backup of live /etc or shadow.
    with tempfile.TemporaryDirectory(prefix="uflinux-install-") as temporary:
        temporary = Path(temporary)
        overlay = temporary / "overlay"
        overlay.mkdir()
        make_overlay(overlay, args, install_repositories, plan["mode"] == "uefi")
        archive = temporary / "install.apkovl.tar.gz"
        with tarfile.open(archive, "w:gz", dereference=False) as tar:
            tar.add(overlay / "etc", arcname="etc")
        command = ["setup-disk", "-m", "sys", "-k", flavor, "-B", "none" if plan["mode"] in {"uefi", "bios"} else "grub", "-o", str(archive)]
        if plan["boot_disk"]:
            command.extend(["-b", plan["boot_disk"]])
        command.append(str(target))
        env = dict(os.environ, ROOTFS="xfs", BOOTFS="vfat" if plan["mode"] in {"uefi", "bios"} else "ext4")
        if plan["mode"] == "uefi":
            env["USE_EFI"] = "1"
        with temporary_repositories(source_repositories, install_repositories):
            try:
                run(*command, env=env)
            except subprocess.CalledProcessError:
                describe_apk_log(target)
                raise
    # setup-disk generates its own mkinitfs.conf, so extend it after installation.
    initfs_conf = target / "etc/mkinitfs/mkinitfs.conf"
    kernels = sorted((target / "lib/modules").glob("*-" + flavor))
    if not kernels:
        raise InstallError("Installed kernel modules are missing; cannot build initramfs")
    configure_early_graphics(target, kernels[-1].name)
    with initfs_conf.open("a") as config:
        config.write('\nfeatures="$features uflinux-graphics uflinux-plymouth"\ninit=/usr/libexec/uflinux-initramfs-init\n')
    run("chroot", str(target), "mkinitfs", "-o", f"/boot/initramfs-{flavor}", kernels[-1].name)
    if plan["mode"] == "uefi" and args.arch == "aarch64":
        install_arm64_efi_hook(target, flavor)
    install_grub(target, plan, media)
    write(target, "etc/apk/repositories", full_repositories)
    user_command = ["chroot", str(target), "adduser", "-D", "-s", "/bin/ash", "-G", "users"]
    if getattr(args, "display_name", None):
        user_command.extend(["-g", args.display_name])
    run(*user_command, args.user)
    run("chroot", str(target), "addgroup", args.user, "wheel")
    run("chroot", str(target), "addgroup", args.user, "netdev")
    # Device access for the printing stack. The scanner group only exists once
    # the printing stack has been enabled (Settings creates it), so both
    # memberships are conditional; the Settings helper adds every interactive
    # account to whichever groups are missing when the toggle is turned on.
    for group in ("lp", "scanner"):
        probe = subprocess.run(["chroot", str(target), "getent", "group", group],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if probe.returncode == 0:
            run("chroot", str(target), "addgroup", args.user, group)
    run("chroot", str(target), "chpasswd", input=f"{args.user}:{password}\n")
    run("chroot", str(target), "passwd", "-l", "root", stdout=subprocess.DEVNULL)
    write(target, "etc/doas.d/uflinux.conf", "permit persist :wheel as root\n", 0o600)
    # All persistent login settings come from the installed defaults package.
    if (target / "etc/doas.d/uflinux-live.conf").exists() or (target / "home/live").exists():
        raise InstallError("Live account contamination detected; do not boot this installation")
    run("sync")


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--target", required=True)
    parser.add_argument("--user", required=True)
    parser.add_argument("--hostname", default="uflinux")
    parser.add_argument("--boot-disk")
    parser.add_argument("--boot-mode", choices=["auto", "uefi", "bios", "native"], default="auto")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--online", action="store_true", help="Allow official Alpine mirrors for packages absent from the media")
    args = parser.parse_args(argv)
    try:
        plan = preflight(args)
        print(json.dumps(plan, indent=2))
        if args.dry_run:
            return 0
        confirmation = f"INSTALL {plan['root']['uuid']}"
        if input(f"Existing files in the target boot filesystem may be replaced.\nType {confirmation} to install: ") != confirmation:
            raise InstallError("Installation cancelled")
        password = getpass.getpass(f"Password for {args.user}: ")
        if len(password) < 8 or "\n" in password or ":" in password:
            raise InstallError("Use at least eight characters, without colons or newlines")
        if password != getpass.getpass("Repeat password: "):
            raise InstallError("Passwords do not match")
        with open("/run/uflinux-install.lock", "w") as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError as exc:
                raise InstallError("Another UFLinux installation is already running") from exc
            install(args, plan, password)
        print("Installation complete. Unmount the target filesystems before rebooting.")
        return 0
    except (InstallError, subprocess.CalledProcessError, OSError, ValueError) as exc:
        print(f"uflinux-install: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
