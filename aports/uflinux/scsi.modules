# Overrides Alpine's scsi.modules: only the SCSI pieces that can be a boot
# device on UFlinux's supported hardware. UFlinux machines boot from NVMe
# (nvme feature), AHCI (ata feature), USB storage (usb feature), virtio-scsi
# (mmc/virtio features and here) or Hyper-V storvsc. Datacenter HBAs (lpfc,
# mpt3sas, megaraid, iscsi/fcoe, ...) stay loadable from the real rootfs.
kernel/drivers/scsi/scsi_mod.ko*
kernel/drivers/scsi/sd_mod.ko*
kernel/drivers/scsi/sr_mod.ko*
kernel/drivers/scsi/sg.ko*
kernel/drivers/scsi/virtio_scsi.ko*
kernel/drivers/scsi/hv_storvsc.ko*
kernel/drivers/hv/hv_vmbus.ko*
