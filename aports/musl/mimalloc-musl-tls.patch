-  #if MI_TLS_MODEL_LOCAL
+  #if MI_TLS_MODEL_MUSL
+    __pthread_self()->malloc_tls = x;
+  #elif MI_TLS_MODEL_LOCAL
     __mi_theap_default = (mi_theap_t*)x;
   #elif MI_TLS_MODEL_FIXED
     mi_prim_tls_slot_set(MI_TLS_MODEL_FIXED_DEFAULT, x);
