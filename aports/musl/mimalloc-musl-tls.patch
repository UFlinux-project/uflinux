+  static inline tp name##_get(void) { tp value = name##_peek(); return value != NULL ? value : initval; } \
+  static inline bool name##_set(tp val) { __pthread_self()->malloc_aux[mi_tls_##name] = mi_tls_sign(val, tag); return true; } \
+  static inline void name##_delete(void) { __pthread_self()->malloc_aux[mi_tls_##name] = NULL; }
