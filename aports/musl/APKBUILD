pkgname=musl
pkgver=99.1.2.6
pkgrel=3
_upstreamver=1.2.6
_mimallocver=3.7.0
pkgdesc="the musl c library (libc) implementation"
url="https://musl.libc.org/"
arch="x86 x86_64 aarch64 armv7 ppc64le riscv64"
license="MIT"
options="lib64 !check !lto"
subpackages="
	$pkgname-dbg
	$pkgname-libintl:libintl:noarch
	$pkgname-dev
	"
case "$BOOTSTRAP" in
nocc)	pkgname="musl-dev"; subpackages="";;
nolibc) ;;
*)	subpackages="$subpackages $pkgname-utils";;
esac
source="https://musl.libc.org/releases/musl-$_upstreamver.tar.gz
	handle-aux-at_base.patch
	0001-add-stub-for-pthread_mutexattr_setprioceiling.patch
	CVE-2026-6042.patch
	CVE-2026-40200.patch
	CVE-2026-107891.patch

	mimalloc-$_mimallocver.tar.gz
	0001-plumb-in-support-for-externally-provided-allocator-l.patch
	mimalloc-musl-tls.patch
	mimalloc.c
	mimalloc-verify-syms.sh
	allocator-test.c

	ldconfig
	__stack_chk_fail_local.c
	getconf.c
	getent.c
	iconv.c
	"
# this is needed for BOOTSTRAP=nocc (see above)
builddir="$srcdir/musl-$_upstreamver"

# secfixes:
#   1.2.6-r3:
#     - CVE-2026-107891
#   1.2.6-r2:
#     - CVE-2026-40200
#   1.2.6-r1:
#     - CVE-2026-6042
#   1.2.5-r10:
#     - CVE-2025-26519
#   1.2.2_pre2-r0:
#     - CVE-2020-28928
#   1.1.23-r2:
#     - CVE-2019-14697
#   1.1.15-r4:
#     - CVE-2016-8859

prepare() {
	mv "$srcdir/mimalloc-$_mimallocver" mimalloc
	cp "$srcdir/mimalloc.c" mimalloc/src/
	cp "$srcdir/mimalloc-verify-syms.sh" .
	default_prepare

	echo "$_upstreamver" > VERSION

	# delete hand-optimized x86-64 string manipulation functions
	# as modern GCC generates faster code
	rm src/string/x86_64/memcpy.s src/string/x86_64/memmove.s
}

build() {
	[ "$BOOTSTRAP" = "nocc" ] && return 0

	# provide minimal libssp_nonshared.a so we don't need libssp from gcc
	${CROSS_COMPILE}cc $CFLAGS -c "$srcdir"/__stack_chk_fail_local.c -o __stack_chk_fail_local.o
	${CROSS_COMPILE}ar r libssp_nonshared.a __stack_chk_fail_local.o

	if [ "$BOOTSTRAP" != "nolibc" ]; then
		# getconf/getent/iconv
		local i
		for i in getconf getent iconv ; do
			${CROSS_COMPILE}cc $CPPFLAGS $CFLAGS "$srcdir"/$i.c -o $i
		done
	fi

	# musl sets a sane default for flags that they tune based on -O2 with alignment things turned off.
	# see https://git.musl-libc.org/cgit/musl/commit/?id=b90841e2583237a4132bbbd74752e0e9563660cd ,
	# and the discussion in https://www.openwall.com/lists/musl/2023/05/22/2
	# this makes libc.so about 5% bigger in itself, but should yield an overall improved libc.so for general use.
	# NB: if musl detects an -O it skips its own, so remove just the O value.
	# Also environment CFLAGS are placed after automatic flags so --enable-optimize doesn't work.
	export CFLAGS="${CFLAGS/-O* /}"

	case "$CARCH" in
	x86_64|aarch64|riscv64)
		CFLAGS="$CFLAGS -fno-reorder-blocks-and-partition"
		# BOLT needs explicit relative relocations for the self-relocating loader.
		LDFLAGS="$LDFLAGS -Wl,--emit-relocs,--build-id,-z,nopack-relative-relocs"
		;;
	esac
	if [ "$CARCH" = riscv64 ]; then
		CFLAGS="$CFLAGS -mno-relax"
		LDFLAGS="$LDFLAGS -Wl,--no-relax"
	fi

	# note: not autotools
	# shellcheck disable=2153
	LDFLAGS="$LDFLAGS -Wl,-soname,libc.musl-$CARCH.so.1" \
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info \
		--localstatedir=/var \
		--enable-debug
	printf '%s\n' 'CFLAGS_ALL += -I$(srcdir)/mimalloc/include -I$(srcdir)/mimalloc/src' \
		'MALLOC_DIR = external' 'EXTRA_OBJ = $(srcdir)/src/malloc/external/mimalloc.o' >> config.mak
	# musl's configure selects i486 for its own code. The Alpine x86 toolchain
	# targets Pentium M, so the allocator can use i586's lock-free cmpxchg8b.
	if [ "$CARCH" = x86 ]; then
		printf '%s\n' 'MIMALLOC_CFLAGS = -march=i586' >> config.mak
	fi
	make MALLOC_DIR=external EXTRA_OBJ=src/malloc/external/mimalloc.o
	if [ "$BOOTSTRAP" != nolibc ]; then
		cc -O2 -fno-builtin -pthread "$srcdir/allocator-test.c" -o allocator-test
		cc -O2 -fno-builtin -pthread -DSTATIC_TEST -static "$srcdir/allocator-test.c" lib/libc.a -o allocator-static-test
		./lib/libc.so ./allocator-test
		./allocator-static-test
	fi
}

package() {
	case "$CARCH" in
	aarch64*)	ARCH="aarch64" ;;
	arm*)		ARCH="arm" ;;
	x86)		ARCH="i386" ;;
	x86_64)		ARCH="x86_64" ;;
	ppc)		ARCH="powerpc" ;;
	ppc64*)		ARCH="powerpc64" ;;
	s390*)		ARCH="s390x" ;;
	mips64*)	ARCH="mips64" ;;
	mips*)		ARCH="mips" ;;
	riscv64)	ARCH="riscv64" ;;
	esac

	if [ "$BOOTSTRAP" = "nocc" ]; then
		make ARCH="$ARCH" prefix=/usr DESTDIR="$pkgdir" install-headers
	else
		case "$CARCH" in
		x86_64|aarch64|riscv64)
			test -s lib/libc.bolt.so
			cp lib/libc.bolt.so lib/libc.so
			;;
		esac
		make DESTDIR="$pkgdir" install

		install -Dm644 mimalloc/LICENSE "$pkgdir/usr/share/licenses/musl/mimalloc-LICENSE"
		cp libssp_nonshared.a "$pkgdir"/usr/lib

		# make LDSO the be the real file, and libc the symlink
		local rule="$(printf "%s\n\t%s\n" 'print-ldso:' '@echo $$(basename $(LDSO_PATHNAME))')"
		local LDSO=$(make -f Makefile --eval "$rule" print-ldso)
		mv -f "$pkgdir"/usr/lib/libc.so "$pkgdir"/lib/"$LDSO"
		ln -sf "$LDSO" "$pkgdir"/lib/libc.musl-$CARCH.so.1
		ln -sf ../../lib/"$LDSO" "$pkgdir"/usr/lib/libc.so
		mkdir -p "$pkgdir"/usr/bin

		cat >>"$pkgdir"/usr/bin/ldd <<-EOF
		#!/bin/sh
		exec /lib/$LDSO --list "\$@"
		EOF
		chmod 755 "$pkgdir"/usr/bin/ldd
	fi

}

utils() {
	depends="scanelf"
	replaces="libiconv"
	license="MIT AND BSD-2-Clause AND GPL-2.0-or-later"

	# for backwards compatibility
	provides="libc-utils=$pkgver-r$pkgrel"

	mkdir -p "$subpkgdir"/usr "$subpkgdir"/sbin
	mv "$pkgdir"/usr/bin "$subpkgdir"/usr/

	install -D \
		"$builddir"/getent \
		"$builddir"/getconf \
		"$builddir"/iconv \
		"$subpkgdir"/usr/bin

	install -D -m755 "$srcdir"/ldconfig "$subpkgdir"/sbin
}

# currently we don't want by default any NLS
# and use GNU gettext where needed. the plan is to migrate to
# musl gettext() later on as fully as possible.
libintl() {
	pkgdesc="musl libintl.h header"
	mkdir -p "$subpkgdir"/usr/include
	mv "$pkgdir"/usr/include/libintl.h \
		"$subpkgdir"/usr/include/
}

dev() {
	default_dev

	# for backwards compatibility
	provides="libc-dev=$pkgver-r$pkgrel"
}

