# The glibc-string / IFUNC additions below are x86_64 and aarch64 only, so their
# sources and checksums are appended conditionally: on another arch abuild would
# otherwise count more checksums than sources and abort. abuild pairs every
# source with the checksum at the same position, so the sha512sums below must
# stay in the same order as the sources above.
#
# Keep this block by hand: `abuild checksum` rewrites sha512sums as a single
# unconditional block at the end of the file.
case "$CARCH" in
x86_64|aarch64)
	license="MIT AND LGPL-2.1-or-later"
	source="$source
		glibc-string-$_glibc_stringver.tar.gz::https://codeload.github.com/bell-sw/glibc-string/tar.gz/refs/tags/$_glibc_stringver
		0100-ldso-dynlink-add-ifunc-support.patch
		0101-support-ifunc-in-static-linking.patch
		0103-use-internal-ifunc-symbols-in-libc.patch
		0105-ifunc-aarch64-support.patch
		0106-support-linking-with-aarch64-glibc-stirng.patch
		0107-link-glibc-string.patch
	"
	sha512sums="$sha512sums
