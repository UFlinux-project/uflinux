From bd36c6bd55419d8bdc090ed006aab41378a42f36 Mon Sep 17 00:00:00 2001
From: Alexey Kodanev <aleksei.kodanev@bell-sw.com>
Date: Fri, 17 Sep 2021 18:13:40 +0300
Subject: [PATCH] support ifunc in static linking

Resolve static PIE IFUNCs after base relocations and TLS setup.
Apply this before initializing the external allocator.

--- a/src/env/__init_tls.c
+++ b/src/env/__init_tls.c
@@ -8,6 +8,8 @@
 #include "libc.h"
 #include "atomic.h"
 #include "syscall.h"
+#include "elf.h"
+#include "reloc.h"
 
 volatile int __thread_list_lock;
 
@@ -83,6 +85,41 @@
 
 extern weak hidden const size_t _DYNAMIC[];
 
+static void relocate_ifuncs(size_t base, const Elf64_Rela *rel, size_t size)
+{
+	for (; size; rel++, size -= sizeof(*rel)) {
+		if (ELF64_R_TYPE(rel->r_info) != REL_IRELATIVE) continue;
+		size_t *dest = (void *)(base + rel->r_offset);
+		*dest = ((size_t (*)(void))(base + rel->r_addend))();
+	}
+}
+
+static void init_ifunc(size_t base)
+{
+	if (_DYNAMIC) {
+		/* Static PIE has already applied RELATIVE and RELR relocations.
+		 * Resolve its IFUNCs now that auxv and TLS are available. */
+		size_t rela = 0, relasz = 0, jmprel = 0, pltrelsz = 0, pltrel = 0;
+		for (const size_t *d = _DYNAMIC; d[0]; d += 2) {
+			switch (d[0]) {
+			case DT_RELA: rela = d[1]; break;
+			case DT_RELASZ: relasz = d[1]; break;
+			case DT_JMPREL: jmprel = d[1]; break;
+			case DT_PLTRELSZ: pltrelsz = d[1]; break;
+			case DT_PLTREL: pltrel = d[1]; break;
+			}
+		}
+		relocate_ifuncs(base, (const void *)(base + rela), relasz);
+		if (pltrel == DT_RELA)
+			relocate_ifuncs(base, (const void *)(base + jmprel), pltrelsz);
+	} else {
+		extern weak hidden const Elf64_Rela __rela_iplt_start[], __rela_iplt_end[];
+		if (__rela_iplt_start && __rela_iplt_end)
+			relocate_ifuncs(0, __rela_iplt_start,
+				(const char *)__rela_iplt_end - (const char *)__rela_iplt_start);
+	}
+}
+
 static void static_init_tls(size_t *aux)
 {
 	unsigned char *p;
@@ -163,6 +200,8 @@
 	if (__init_tp(self) < 0)
 		a_crash();
 
+	init_ifunc(base);
+
 	/* Initialize malloc. */
 	__malloc_init(self);
 }
