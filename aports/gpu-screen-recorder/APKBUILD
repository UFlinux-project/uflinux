# Maintainer: UFLinux contributors <noreply@example.invalid>
# Upstream 6.1.7 plus the UFLinux patch series (V4L2 mem2mem encoder, WebP screenshots).
pkgname=gpu-screen-recorder
pkgver=6.1.7
pkgrel=4
pkgdesc="GPU screen capture backend for uflinux-screencapture"
url="https://git.dec05eba.com/gpu-screen-recorder/about/"
arch="x86_64 aarch64 ppc64le riscv64"
license="GPL-3.0-only"
depends="dbus-libs ffmpeg-libs libcap2 libcap-setcap libdrm libpulse libturbojpeg libwebp
	libx11 libxcomposite libxdamage libxfixes libxrandr mesa-egl mesa-gbm mesa-gl
	pipewire-libs wayland-libs-client wayland-libs-egl vulkan-loader"
makedepends="clang22 lld22 llvm22 compiler-rt build-base meson abuild-meson ninja pkgconfig linux-headers vulkan-headers
	ffmpeg-dev libx11-dev libxcomposite-dev libxrandr-dev libxfixes-dev libxdamage-dev
	wayland-dev libdrm-dev dbus-dev pulseaudio-dev libva-dev libcap-dev mesa-dev
	pipewire-dev libjpeg-turbo-dev libwebp-dev"
subpackages="$pkgname-dbg $pkgname-doc $pkgname-dev"
# The KMS capture server needs CAP_SYS_ADMIN; ship the file capability so that
# direct monitor capture works for a normal user without a setuid root helper.
options="setcap"
source="$pkgname-$pkgver.tar.gz::https://dec05eba.com/snapshot/gpu-screen-recorder.git.$pkgver.tar.gz
	0001-Add-V4L2-mem2mem-codec-capability-probe.patch
	0002-Add-V4L2-mem2mem-video-encoder-backend.patch
	0003-Build-add-v4l2_encoder-option-and-ffmpeg-v4l2m2m-sup.patch
	0004-Add-v4l2-video-codec-encoder-and-v4l2-device-option.patch
	0005-Wire-v4l2-mem2mem-encoder-into-codec-selection.patch
	0006-Wire-v4l2-mem2mem-encoder-into-the-codec-open-path.patch
	0007-info-report-v4l2-mem2mem-encoders.patch
	0008-Add-webp-screenshot-support.patch
	0009-Docs-document-v4l2-encoder-and-webp-screenshots.patch
	0010-Encoder-align-v4l2-m2m-capture-for-Qualcomm-venus.patch
	0011-Check-recording-video-output.patch
	gsr-kms-capability.initd
	pgo-train.sh pgo-flush.c"
# The upstream snapshot has no leading directory component.
builddir="$srcdir"

prepare() {
	default_prepare
}

_bolt_optimize() (
	local bins=$1 work=$2 profiles=$3 name binary
	export PATH="${UFLINUX_APORT_BOLT_DIR:+$UFLINUX_APORT_BOLT_DIR:}$PATH"
	shift 3
	if [ "${UFLINUX_APORT_PROFILE_REPLAY:-0}" != 1 ]; then
		mkdir -p "$work/bolt"
		for name; do
			rm -f "$work/bolt/$name".fdata.*
			llvm-bolt "$bins/$name" --instrument --no-huge-pages -o "$work/bolt/$name" \
				--instrumentation-file="$work/bolt/$name.fdata" --instrumentation-file-append-pid \
				--instrumentation-binpath="$work/bolt/$name"
		done
		GSR_PROFILE_PRELOAD="$work/pgo-flush.so" _train "$work/bolt" "$work"
		for name; do
			merge-fdata "$work/bolt/$name".fdata.* > "$profiles/$name.fdata"
		done
	fi
	for name; do
		test -s "$profiles/$name.fdata"
		binary=$(realpath "$bins/$name")
		llvm-bolt "$binary" --data="$profiles/$name.fdata" -o "$binary.optimized" \
			--no-huge-pages --reorder-blocks=ext-tsp --reorder-functions=cdsort \
			--update-debug-sections --dyno-stats
		mv "$binary.optimized" "$binary"
	done
)

_train() {
	timeout -k 5 45 sh "$srcdir/pgo-train.sh" "$@"
}

build() {
	local work="$srcdir/optimization" profiles flags
	profiles=${UFLINUX_APORT_PROFILES:-"$work/profiles"}
	export CC=clang-22 CC_LD=lld
	export CFLAGS="$CFLAGS -O3 -flto=full"
	export LDFLAGS="$LDFLAGS -O3 -flto=full"
	case "$CARCH" in
		x86_64|aarch64) LDFLAGS="$LDFLAGS -Wl,--emit-relocs,-z,nopack-relative-relocs" ;;
	esac
	# AArch64 musl runs the fini array. Omit DT_FINI so BOLT hooks that array.
	if [ "$CARCH" = aarch64 ]; then
		LDFLAGS="$LDFLAGS -Wl,-fini,0"
	fi

	mkdir -p "$work/raw" "$profiles"
	flags="-fprofile-use=$profiles/pgo.profdata"
	if [ "${UFLINUX_APORT_PROFILE_REPLAY:-0}" != 1 ]; then
		flags=-fprofile-generate
		"$CC" -shared -fPIC -o "$work/pgo-flush.so" "$srcdir/pgo-flush.c"
	fi
	abuild-meson build \
		-Dc_args="$CFLAGS $flags" -Dc_link_args="$LDFLAGS $flags" \
		-Dsystemd=false -Dcapabilities=false -Dnvidia_suspend_fix=false \
		-Dapp_audio=false -Dportal=true -Dplugin_examples=false \
		-Dffmpeg_static=false -Dv4l2_encoder=true -Dwebp_screenshots=true

	if [ "${UFLINUX_APORT_PROFILE_REPLAY:-0}" != 1 ]; then
		rm -f "$work/raw/"*.profraw
		meson compile -C build
		GSR_PROFILE_PRELOAD="$work/pgo-flush.so" LLVM_PROFILE_FILE="$work/raw/%m-%p.profraw" \
			_train "$builddir/build" "$work"
		/usr/lib/llvm22/bin/llvm-profdata merge -o "$profiles/pgo.profdata" "$work/raw/"*.profraw
		flags="-fprofile-use=$profiles/pgo.profdata"
		meson configure build -Dc_args="$CFLAGS $flags" -Dc_link_args="$LDFLAGS $flags"
	fi

	test -s "$profiles/pgo.profdata"
	meson compile -C build

	case "$CARCH" in
		x86_64|aarch64)
			_bolt_optimize "$builddir/build" "$work" "$profiles" gpu-screen-recorder gsr-cli gsr-kms-server
			;;
	esac
}

check() {
	_train "$builddir/build" "$srcdir/optimization"
}

package() {
	DESTDIR="$pkgdir" meson install -C build
	setcap cap_sys_admin+ep "$pkgdir/usr/bin/gsr-kms-server"
	install -Dm755 "$srcdir/gsr-kms-capability.initd" "$pkgdir/etc/init.d/gsr-kms-capability"
}

